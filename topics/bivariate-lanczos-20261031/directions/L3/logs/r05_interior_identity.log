P = 2*sqrt(S)*sqrt(T)*sqrt(1 - S)*sqrt(1 - T) - 2*S*T + S + T   [= sin^2 a]
R = -2*sqrt(S)*sqrt(T)*sqrt(1 - S)*sqrt(1 - T) - 2*S*T + S + T   [= sin^2 b]
W = -(S - T)*(8*S*T*c - 1)
